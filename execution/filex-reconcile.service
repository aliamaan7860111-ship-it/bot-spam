[Unit]
Description=Filex nightly reconciliation (alerts + status)
After=network.target

[Service]
Type=oneshot
User=bilal
WorkingDirectory=/home/bilal/automation
EnvironmentFile=/home/bilal/automation/.env
ExecStart=/home/bilal/automation/venv/bin/python /home/bilal/automation/execution/filex_reconcile.py
StandardOutput=append:/home/bilal/automation/.tmp/filex_reconcile.log
StandardError=append:/home/bilal/automation/.tmp/filex_reconcile.log
