# Environment variables and API keys (TEMPLATE — copy to .env and fill in real values)

# --- Notion CRM ---
NOTION_API_KEY=your-notion-api-key-here
NOTION_DATABASE_ID=your-notion-database-id-here

# --- Telegram Bot ---
TELEGRAM_BOT_TOKEN=your-telegram-bot-token-here
TELEGRAM_SOURCING_GROUP_ID=-100xxxxxxxxx
TELEGRAM_FULFILLMENT_GROUP_ID=-100xxxxxxxxx

# --- Polling ---
POLL_INTERVAL_SECONDS=5

# --- Only process orders created after this date ---
ORDER_CUTOFF_DATE=2026-01-01T00:00:00+05:00

# --- Static Ads Pipeline ---
ANTHROPIC_API_KEY=sk-ant-api03-your-key-here
SLACK_APP_TOKEN=xapp-your-token-here
SLACK_BOT_TOKEN=xoxb-your-token-here
NANO_BANANA_GEMINI_API_KEY=your-gemini-api-key-here
BRAND_GOOGLE_DRIVE_URL=https://drive.google.com/drive/folders/your-folder-id

# --- Fal.ai Integration ---
FAL_KEY=your-fal-key-here

# --- Load Testing Bot ---
TEST_STORE_URL=https://your-store.com
TEST_INTERVAL_MINS=0.1
TEST_PROXY=http://user:pass@proxy-host:port
BLOCK_RESOURCES=True

# --- WhatChimp Integration ---
WHATCHIMP_API_TOKEN=your-whatchimp-api-token-here
WHATCHIMP_PHONE_NUMBER_ID=your-phone-number-id-here
WHATCHIMP_BOT_FLOW_ID=your-bot-flow-id-here

# --- Filex API ---
FILEX_USERNAME=your-filex-username
FILEX_PASSWORD=your-filex-password
FILEX_ACCOUNT_NUMBER=your-filex-account-number
FILEX_API_BASE=https://filex-shipperapi.dispatchex.com
FILEX_WEBHOOK_TOKEN=replace-with-token-from-filex-dev
FILEX_TRACKING_BASE_URL=https://www.filexexpress.ae/track?awb=
